{
  "manifest_version": 3,
  "name": "메뉴 자동화 브리지",
  "version": "1.2.1",
  "description": "menu CLI(localhost)의 명령을 받아 쿠팡이츠·배민 메뉴 관리 화면을 조작합니다.",
  "permissions": [
    "scripting",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://store.coupangeats.com/*",
    "https://self.baemin.com/*",
    "https://biz-member.baemin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://store.coupangeats.com/*",
        "https://self.baemin.com/*"
      ],
      "js": [
        "keepalive.js"
      ],
      "run_at": "document_idle"
    }
  ]
}